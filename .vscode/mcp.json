{
	"servers": {
		"aspire": {
			"type": "stdio",
			"command": "aspire",
			"args": [
				"agent",
				"mcp"
			]
		},
		"svelte-mcp-server": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@sveltejs/mcp"
			]
		},
		"shadcdn-mcp-server": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"skills",
				"add",
				"shadcn/ui"
			]
		}
	},
	"inputs": []
}