<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.4.6" />
    <!-- Flare.Hosting.Aspire (project: src/Aspire.Hosting.Flare/) - the published integration
         package references Aspire.Hosting directly (not Aspire.Hosting.AppHost - that's the
         AppHost-executable meta-package), per Aspire's own "Create custom hosting integrations"
         doc pattern. -->
    <PackageVersion Include="Aspire.Hosting" Version="13.4.6" />
    <!-- Aspire.Hosting.Docker: only needed for PublishAsDockerComposeService, which AddFlare
         uses to mirror its Docker-driven-Resources-page labels onto the generated Docker
         Compose service definitions (docs/aspire-hosting.md's "Publishing / deploying via
         aspire publish" section) - a consuming AppHost that never calls
         AddDockerComposeEnvironment never touches this, but the extension method itself has
         to be in scope at compile time regardless. Pinned to match every other Aspire package
         here. -->
    <PackageVersion Include="Aspire.Hosting.Docker" Version="13.4.6" />
    <!-- ClickHouse: schema in db/clickhouse/, see db/clickhouse/README.md.
         Aspire.Hosting.ClickHouse is referenced by Flare.AppHost today.
         Aspire.ClickHouse.Driver is referenced by Flare.Ingest/Flare.Api (the batched
         insert pipeline and query API) and Flare.ServiceDefaults (ClickHouseMigrationRunner). -->
    <PackageVersion Include="Aspire.Hosting.ClickHouse" Version="13.4.6" />
    <PackageVersion Include="Aspire.ClickHouse.Driver" Version="13.4.6" />
    <!-- Redis: durable Redis-Streams buffer for the batched ClickHouse insert pipeline
         (Planning.md's "Buffering layer" decision, 2026-08-07). Pinned at 13.4.6 to match
         every other Aspire package here / global.json's Aspire.AppHost.Sdk - the locally
         cached 13.3.1 build of these two is stale and would silently downgrade if picked
         instead; first restore of these two needs to go online, same one-time situation
         already accepted above for Aspire.ClickHouse.Driver. -->
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.4.6" />
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.4.6" />
    <!-- Flare.ServiceDefaults: standard Aspire template observability stack -->
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.10" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <!-- Flare.Aspire (project: src/Aspire.Flare/) - the client-side package (v2 roadmap item).
         Pinned at 10.0.10 to match Microsoft.Extensions.Diagnostics.HealthChecks above (same
         .NET 10 servicing train). -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <!-- Flare.Ingest: OTLP receiver -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.35.1" />
    <!-- Flare.Api: query API (search/filter/time-range/aggregate) over the ClickHouse
         `logs` table. OpenApi pinned at 10.0.10 to match Microsoft.Extensions.Diagnostics.HealthChecks
         above (same .NET 10 servicing train) - gives a browsable /openapi endpoint for
         manually exercising the API before the dashboard (still an open question, see
         Planning.md #1) exists to call it. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Microsoft.AspNetCore.OpenApi 10.0.10 transitively pulls Microsoft.OpenApi 2.0.0,
         which has a known high-severity advisory (GHSA-v5pm-xwqc-g5wc, circular schema
         references can hang the parser) fixed in 2.7.5. Pinned directly + referenced
         from Flare.Api.csproj so the direct reference wins over the transitive one. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- Flare.Api: Microsoft Entra ID (SSO) login (Planning.md's "Entra ID (SSO) auth"
         item, docs/auth.md). Unlike AddCookie/the base AddScheme, the OpenIdConnect
         handler was split out of the Microsoft.AspNetCore.App shared framework into its
         own NuGet package back in .NET Core 3.0 and never moved back - a real
         FrameworkReference gap, confirmed by the CS0234 this package fixes. Pinned at
         10.0.10 to match every other .NET-10-servicing-train package above. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.10" />
    <!-- Flare.Api: shares the Data Protection key ring across replicas via Redis (Planning.md's
         "Multi-node scaling" item) so a mid-Entra/OIDC-handshake external cookie survives
         landing on a different replica than the one that issued it. Pinned at 10.0.10 to
         match every other .NET-10-servicing-train package above. -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.10" />
    <!-- Flare.Api: Active Directory (LDAP) login (Planning.md's "Active Directory auth"
         item, docs/auth.md). Cross-platform LDAP client (works from the Linux container
         this project ships) - unlike classic System.DirectoryServices/ADSI, which is
         Windows-only. Pinned at 10.0.10 to match every other .NET-10-servicing-train
         package above. -->
    <PackageVersion Include="System.DirectoryServices.Protocols" Version="10.0.10" />
    <!-- Flare.Identity: local username/password auth + roles, embedded-SQLite-backed
         (Planning.md's "Auth + multi-user / roles" Later-roadmap item, 2026-08-10 design
         decision - SQLite over a new Postgres container, see docs/auth.md). Pinned at
         10.0.10 to match every other .NET-10-servicing-train package above. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- PasswordHasher<T> (Auth/AspNetPasswordHasher.cs) comes from the ASP.NET Core
         shared framework (Microsoft.AspNetCore.App FrameworkReference) in .NET 10, not a
         separate Microsoft.Extensions.Identity.Core package reference - confirmed via
         NU1510 package-pruning warning when one was added, then a clean build without it. -->
    <!-- Microsoft.Data.Sqlite 10.0.0 floors its SQLitePCLRaw.* dependencies at >=2.1.11,
         which NuGet audit flags as GHSA-2m69-gcr7-jv3q (high severity, vulnerable bundled
         SQLite). 2.1.12 is a same-API-shape patch release on the 2.1.x branch (SQLitePCLRaw
         restructured its packages in 3.x, which Microsoft.Data.Sqlite 10.0.x doesn't
         target) - pinned directly + referenced from Flare.Identity.csproj so it wins over
         the transitive 2.1.11 floor, same pattern already used above for Microsoft.OpenApi. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="2.1.12" />
    <!-- Flare.Cli: command routing (attribute-based commands/options, built-in help and
         version flags) plus Spectre.Console's table renderer (flare status) and spinner
         (flare start's health-poll wait) - one dependency covers both instead of
         System.CommandLine (parsing only, still pre-1.0 as of this pin) plus a separate
         rendering library. 0.55.0 confirmed as latest stable via nuget.org's
         flatcontainer index (next releases are 1.0.0-alpha.*, not yet stable). -->
    <PackageVersion Include="Spectre.Console.Cli" Version="0.55.0" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>