<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Flare.Cli</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- dotnet tool packaging. PackageId is Flare.Cli, NOT "flare" - "flare" is already taken
         on nuget.org (an old, unrelated, unlisted package - verified directly against
         nuget.org's registration API before choosing this id), so a push under it would be
         rejected outright. ToolCommandName is independent of PackageId:
         `dotnet tool install -g Flare.Cli` still installs a tool invoked as `flare`. Mirrors
         the Aspire.Hosting.Flare -> Flare.Hosting.Aspire reserved-id workaround already used
         in this repo (see that project's own csproj/README for the same lesson). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>flare</ToolCommandName>
    <PackageType>DotnetTool</PackageType>
    <PackageId>Flare.Cli</PackageId>
    <!-- Pre-1.0, matching Flare.Hosting.Aspire/Flare.Aspire's own pre-alpha posture. Bumped
         0.1.0 -> 0.1.1: the generated .env template's FLARE_IMAGE_TAG default (and state.json's
         ImageTag fallback) changed from the floating "edge" tag to a pinned stable release
         ("0.2.0") - see docs/cli.md's Image tag policy section. Bumped 0.1.1 -> 0.1.2
         (not yet tag-released - see this file's own version-tag instructions in
         .github/workflows/nuget-publish.yml): the generated .env template's
         FLARE_DASHBOARD_PORT default moved 3000 -> 7777 (3000 collides with the
         near-universal Next.js/Vite/CRA/Grafana dev-server default - see docs/cli.md's
         Known limitations section); `flare start`/`flare doctor` also gained a
         host-port-availability preflight (DoctorChecks.CheckPortsAvailable) that reports
         which specific port is taken instead of surfacing Docker's raw bind error; and
         `flare update` gained a tag override option (UpdateCommand.Settings.Tag), the
         CLI-native way to move an existing install's FLARE_IMAGE_TAG pin without hand
         editing .env (FlareHome.SetEnvValue) - see docs/cli.md's Image tag policy
         section for the flag's actual spelling. Bumped 0.1.2 -> 0.1.3: the remaining
         dashboard-parity commands from Planning.md's "Later" list landed -
         `flare search` (one-shot `POST /api/logs/search`, TracesCommand-shaped),
         `flare export` (streaming NDJSON/CSV dump over the same endpoint's cursor
         pagination, field-set parity with the dashboard's own CSV/XLSX export dialog),
         `flare alerts list`/`flare alerts test <ID>` (first command *branch* in this
         CLI - GET /api/alerts, dry-run POST /api/alerts/{id}/test), and
         `flare apikey create <NAME>` (POST /api/ingest-keys, raw key shown once). No
         backend changes - all four are thin HTTP clients against endpoints Flare.Api
         already exposed. Bumped 0.1.3 -> 0.1.4: `flare start` gained a Cluster flag
         (Commands/StartCommand.Settings) standing an instance up as the multi-node
         ClickHouse cluster topology (docs/clustering.md) instead of the single-node
         default - own embedded compose template + env template (Templates/
         docker-compose.cluster.flare.yml, env.cluster.template) plus embedded keeper/
         ClickHouse config (db/clickhouse-cluster/config), materialized the same way
         Standalone's own ClickHouse init SQL already is. Every per-service list that
         used to be hardcoded once per command (StartCommand/DoctorChecks/StatusCommand/
         UpdateCommand/DestroyCommand) is now driven by one new Internal/
         TopologyProfile.cs instead. Topology is decided once at an instance's first
         `flare start` and persisted to state.json - not a live migration path, mismatch
         against an already-initialized instance errors clearly. `flare instances list`
         gained a Mode column. Also fixed a real upstream bug this surfaced in
         Flare.ServiceDefaults' ClickHouseMigrationRunner (see that file's own remarks) -
         cluster mode's bootstrap CREATE DATABASE always failed with UNKNOWN_DATABASE
         since nothing created clickhousedb before the app's own already-scoped
         connection tried to. Bumped 0.1.4 -> 0.1.5: cluster mode's own default
         FLARE_IMAGE_TAG (Internal/TopologyProfile.cs's ClusterProfile, and
         Templates/env.cluster.template) moved from "edge" to "0.3.0" - v0.3.0 (cut the
         same day) is the first stable Flare release that actually contains cluster-mode
         support, so pinning to a real tag instead of tracking main is now possible; the
         standalone default stays 0.2.0, unaffected. Tag on release: flare-cli-v{Version}
         (see .github/workflows/nuget-publish.yml). -->
    <Version>0.1.5</Version>
    <Authors>Amin Parsa</Authors>
    <Description>Standalone lifecycle manager for Flare's non-Aspire Docker stack (start/stop/status/update/open/logs/doctor/destroy). Not an Aspire integration - see Flare.Hosting.Aspire/Flare.Aspire for that path; `aspire start` already covers Aspire-wired Flare.</Description>
    <PackageTags>flare;cli;dotnet-tool;docker;opentelemetry;logging;observability</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/aminparsa18/Flare.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aminparsa18/Flare.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- No GenerateDocumentationFile here unlike Aspire.Hosting.Flare/Aspire.Flare -
         those are libraries with a real consumed API surface; this is an exe tool with
         no public API for anyone to reference, so its command types are `internal`
         (see Commands/*.cs) rather than carrying doc comments for nothing. -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packed straight from their existing location - not physically copied into this
         project. Same pattern as Aspire.Hosting.Flare.csproj/Aspire.Flare.csproj. -->
    <None Include="..\..\logo.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated stack definition, embedded so `flare start` can materialize it into
         ~/.flare/ on first run without this repo checked out. NOT root docker-compose.yml
         re-embedded verbatim: references published xracer007/flare-* images (image:), not
         local build contexts (build:), since this tool runs from an arbitrary directory,
         not necessarily a Flare.Net checkout. -->
    <EmbeddedResource Include="Templates\docker-compose.flare.yml">
      <LogicalName>Flare.Cli.Templates.docker-compose.flare.yml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Templates\env.template">
      <LogicalName>Flare.Cli.Templates.env.template</LogicalName>
    </EmbeddedResource>
    <!-- Same embedding trick Aspire.Hosting.Flare already uses for the same reason: a
         consumer has no db/clickhouse/ on disk to bind-mount into ClickHouse. Materialized
         to ~/.flare/db/clickhouse/ on first run (see Internal/FlareHome.cs). -->
    <EmbeddedResource Include="..\..\db\clickhouse\*.sql">
      <LogicalName>Flare.Cli.Templates.ClickHouseInit.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Cluster-mode `flare start` (its Cluster flag) - see docs/clustering.md and Internal/TopologyProfile.cs.
         Own image-based compose template (root docker-compose.cluster.yml's ingest/api/
         dashboard use `build:`, same reason docker-compose.flare.yml above isn't a
         verbatim copy of root docker-compose.yml either) plus its own .env template
         (different port table - no CLICKHOUSE_HTTP_PORT, plus FLARE_INGEST2_*). No
         db/clickhouse-cluster/*.sql embedding needed here: that schema is already
         embedded inside Flare.ServiceDefaults and applied by ClickHouseMigrationRunner
         at app startup (ClickHouse__ClusterMode=true), not via a bind-mounted init
         directory the way Standalone's ClickHouseInit above is. -->
    <EmbeddedResource Include="Templates\docker-compose.cluster.flare.yml">
      <LogicalName>Flare.Cli.Templates.docker-compose.cluster.flare.yml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Templates\env.cluster.template">
      <LogicalName>Flare.Cli.Templates.env.cluster.template</LogicalName>
    </EmbeddedResource>
    <!-- keeper-N.xml/macros-N.xml/remote-servers.xml/use-keeper.xml/nginx-lb.conf -
         bind-mounted into the keeper/clickhouse/clickhouse-lb CONTAINERS themselves
         (unlike ClickHouseInit above, which mounts into clickhouse's own
         docker-entrypoint-initdb.d). Materialized to
         ~/.flare/db/clickhouse-cluster/config/ on first run. -->
    <EmbeddedResource Include="..\..\db\clickhouse-cluster\config\*">
      <LogicalName>Flare.Cli.Templates.ClusterConfig.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
