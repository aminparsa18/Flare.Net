# Generated by the `flare` CLI on first `flare start --cluster` into
# ~/.flare/.env (or ~/.flare/instances/<NAME>/.env). Written once; `flare start` never
# overwrites it again, so it's safe to hand-edit.
#
# CLICKHOUSE_PASSWORD/REDIS_PASSWORD below are randomly generated per-install (see
# Internal/EnvGenerator.cs), NOT the repo's own docker-compose.cluster.yml `flare`/
# `flare` default - this instance is meant to stand for weeks with its ports bound on
# your machine the whole time, not be torn down after a quick eval, so a known public
# default password isn't an acceptable default here. See docs/cli.md for the full
# rationale.
CLICKHOUSE_PASSWORD={{CLICKHOUSE_PASSWORD}}
REDIS_PASSWORD={{REDIS_PASSWORD}}

# Same port defaults as Flare.Net's own docker-compose.cluster.yml (a named instance's
# own defaults are auto-probed instead - see docs/cli.md's Multi-instance support
# section) - change any of these if they collide with something else already running on
# your machine. No CLICKHOUSE_HTTP_PORT here (unlike the standalone .env) - cluster mode
# doesn't publish any ClickHouse node (or clickhouse-lb) to the host, only through the
# ingest/api services below; see docs/clustering.md.
FLARE_INGEST_GRPC_PORT={{FLARE_INGEST_GRPC_PORT}}
FLARE_INGEST_HTTP_PORT={{FLARE_INGEST_HTTP_PORT}}
FLARE_INGEST2_GRPC_PORT={{FLARE_INGEST2_GRPC_PORT}}
FLARE_INGEST2_HTTP_PORT={{FLARE_INGEST2_HTTP_PORT}}
FLARE_API_PORT={{FLARE_API_PORT}}
FLARE_DASHBOARD_PORT={{FLARE_DASHBOARD_PORT}}

# Which Docker Hub tag flare-{ingest,api,dashboard} are pulled at (the ClickHouse/Keeper
# images stay on their own floating `:latest` tag, same as the standalone .env's
# `clickhouse`/`redis` services already do - untracked by `flare update`'s diff).
#
# Pinned to 0.3.0 - the first stable Flare release with cluster-mode support
# (ClickHouse__ClusterMode, the SqlCluster migration set); v0.2.0 predates it and would
# crash-loop trying to bootstrap `clickhousedb` (confirmed live while building this
# template, fixed in ClickHouseMigrationRunner, then verified against 0.3.0's actual
# published image). Deliberately its own pin, independent of the standalone .env's -
# see docs/cli.md's image tag policy section.
FLARE_IMAGE_TAG=0.3.0

# SMTP for the alerting Email channel - blank by default (no working default mail
# server exists). A rule whose channel is Email just fails per-send with a clear error
# until these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_STARTTLS=true

# Must resolve from *your browser*, not from inside the compose network - override if
# you're opening the dashboard from a different host than the one running `flare start`.
# Derived from FLARE_API_PORT above at generation time.
PUBLIC_API_URL={{PUBLIC_API_URL}}
