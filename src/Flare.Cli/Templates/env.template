# Generated by the `flare` CLI on first `flare start` into ~/.flare/.env. Written once;
# `flare start` never overwrites it again, so it's safe to hand-edit.
#
# CLICKHOUSE_PASSWORD/REDIS_PASSWORD below are randomly generated per-install (see
# Internal/EnvGenerator.cs), NOT the repo's own docker-compose.yml `flare`/`flare`
# default - this instance is meant to stand for weeks with its ports bound on your
# machine the whole time, not be torn down after a quick eval, so a known public default
# password isn't an acceptable default here. See docs/cli.md for the full rationale.
CLICKHOUSE_PASSWORD={{CLICKHOUSE_PASSWORD}}
REDIS_PASSWORD={{REDIS_PASSWORD}}

# Same port defaults as Flare.Net's own docker-compose.yml / .env.example - change any of
# these if they collide with something else already running on your machine (including,
# notably, a repo-local `docker compose up` of the same stack - see docs/cli.md's Known
# limitations).
FLARE_INGEST_GRPC_PORT=4317
FLARE_INGEST_HTTP_PORT=4318
FLARE_API_PORT=8080
FLARE_DASHBOARD_PORT=7777
CLICKHOUSE_HTTP_PORT=8123

# Which Docker Hub tag flare-{ingest,api,dashboard} are pulled at. Pinned to the latest
# stable Flare release this CLI version was tested against (currently 0.2.0), not the
# floating "edge"/"latest" tags - `flare update` re-pulls this same pinned tag, it does
# not auto-track newer releases. Change to "edge" yourself to track Flare's unreleased
# main branch instead. See docs/cli.md's image tag policy section.
FLARE_IMAGE_TAG=0.2.0

# SMTP for the alerting Email channel - blank by default (no working default mail
# server exists). A rule whose channel is Email just fails per-send with a clear error
# until these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_STARTTLS=true

# Must resolve from *your browser*, not from inside the compose network - override if
# you're opening the dashboard from a different host than the one running `flare start`.
PUBLIC_API_URL=http://localhost:8080

# Opt-in Resources page (docs/standalone.md / docs/cli.md) - both of the following must
# be uncommented to enable it:
# FLARE_DOCKER_PROXY_URL=http://docker-proxy:8080
# COMPOSE_PROFILES=resource-graph
