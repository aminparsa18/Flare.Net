<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NuGet package metadata. Version starts pre-1.0, matching Flare.Hosting.Aspire - pre-alpha,
         no stable release yet.

         PackageId is Flare.Aspire, NOT Aspire.Flare - that prefix is reserved on nuget.org
         (Microsoft owns the real Aspire.* namespace for official integrations); see
         Aspire.Hosting.Flare.csproj's PackageId comment and Planning.md for how this was
         discovered. Project/directory/namespace names are unaffected; only the published
         package identity changed. -->
    <PackageId>Flare.Aspire</PackageId>
    <!-- 0.1.1, not 0.1.0: 0.1.0 was tagged/attempted under the old reserved Aspire.Flare
         PackageId before the rename above (see the PackageId comment and Planning.md) - that tag
         already exists in git history, so this bump avoids colliding with it locally rather than
         forcing/reusing a tag that documents the abandoned name. -->
    <Version>0.1.1</Version>
    <Authors>Amin Parsa</Authors>
    <Description>.NET Aspire client integration that points a service project's OTLP log exporter at Flare, a self-hosted OpenTelemetry-native log dashboard. Call builder.AddFlareOtlpExporter("flare") to read the connection info injected by .WithReference(flare) (Flare.Hosting.Aspire) and register a named OTLP log exporter against it.</Description>
    <PackageTags>aspire;aspire-integration;flare;opentelemetry;otlp;logging;observability</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/aminparsa18/Flare.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aminparsa18/Flare.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packed straight from their existing location - not physically copied into this project. -->
    <None Include="..\..\logo.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hosting/Configuration abstractions to read IHostApplicationBuilder.Configuration and bind
         FlareSettings, mirroring Aspire.Seq's dependency set. OpenTelemetry.Extensions.Hosting +
         OpenTelemetry.Exporter.OpenTelemetryProtocol give AddOpenTelemetry()/WithLogging()/the
         named AddOtlpExporter(string, ...) overload this package registers against. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

</Project>
