node_modules

# MemoryPack TypeScript codegen output (src/Flare.Api/Flare.Api.csproj's
# MemoryPackGenerator_TypeScriptOutputDirectory) - regenerated by `dotnet build` on
# Flare.Api (wired into `npm run build`/`dev`/`check` via predev/prebuild/precheck), never
# hand-edited, so it's not committed - same reasoning the JSON DTOs were never duplicated
# into a second hand-maintained copy.
/src/lib/generated/memorypack

# Paraglide JS i18n codegen output - regenerated by the Vite plugin (vite.config.ts) and
# by `npm run codegen` (wired into predev/prebuild/precheck, same as MemoryPack above),
# never hand-edited. project.inlang/settings.json and messages/*.json are the real,
# hand-authored source of truth and ARE committed.
/src/lib/paraglide

