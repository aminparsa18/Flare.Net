{
	"name": "flare-dashboard",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"codegen": "dotnet build ../Flare.Api/Flare.Api.csproj -c Debug -clp:ErrorsOnly",
		"predev": "npm run codegen",
		"dev": "vite dev",
		"prebuild": "npm run codegen",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "npm run codegen",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"dependencies": {
		"@dagrejs/dagre": "^3.1.1",
		"@fontsource-variable/noto-sans": "^5.3.0",
		"@lucide/svelte": "^1.33.0",
		"@xyflow/svelte": "^1.6.2",
		"clsx": "^2.1.1",
		"lottie-web": "^5.13.0",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.56.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.3",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"bits-ui": "^2.18.1",
		"shadcn-svelte": "^1.5.0",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
