{
	"name": "flare-dashboard",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"codegen": "dotnet build ../Flare.Api/Flare.Api.csproj -c Debug -clp:ErrorsOnly && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale",
		"predev": "npm run codegen",
		"dev": "vite dev",
		"prebuild": "npm run codegen",
		"build": "vite build",
		"bench": "npm run codegen && tsx bench/memorypack-vs-json.bench.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "npm run codegen",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"dependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@dagrejs/dagre": "^3.1.3",
		"@fontsource-variable/noto-sans": "^5.3.0",
		"@lucide/svelte": "^1.61.0",
		"@rrweb/replay": "2.2.0",
		"@xyflow/svelte": "^1.7.0",
		"clsx": "^2.1.1",
		"gridstack": "^14.0.0",
		"lottie-web": "^5.13.0",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.57.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.29.1",
		"@internationalized/date": "^3.12.4",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22.20.5",
		"bits-ui": "^2.20.2",
		"shadcn-svelte": "^1.7.1",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.0",
		"tinybench": "^6.2.2",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	}
}
