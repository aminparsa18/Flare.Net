# Base URL of a running Flare.Api instance. Defaults to its fixed standalone dev port
# (see src/Flare.Api/Properties/launchSettings.json) if unset.
PUBLIC_API_URL=http://localhost:5085

# Optional: shows an "Open in Grafana" button on trace pages. An http(s) URL with a {traceId} placeholder.
# PUBLIC_GRAFANA_TRACE_URL=https://grafana.example.com/explore?left=...{traceId}...
