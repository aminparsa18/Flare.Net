{
  "__inputs": [
    {
      "name": "DS_FLARE",
      "label": "Flare",
      "description": "The Flare data source",
      "type": "datasource",
      "pluginId": "apardev-flare-datasource",
      "pluginName": "Flare"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "apardev-flare-datasource",
      "name": "Flare",
      "version": "0.3.0"
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "title": "Flare app health",
  "uid": "flare-app-health",
  "tags": ["flare", "mobile", "release"],
  "description": "Crash-free sessions, rollout, app start and screen performance, errors and triage for the apps reporting to Flare.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Releases",
        "enable": true,
        "iconColor": "#FF9830",
        "datasource": {
          "type": "apardev-flare-datasource",
          "uid": "${DS_FLARE}"
        },
        "target": {
          "refId": "Anno",
          "kind": "releases",
          "service": "$service",
          "datasource": {
            "type": "apardev-flare-datasource",
            "uid": "${DS_FLARE}"
          }
        },
        "mappings": {
          "time": {
            "source": "field",
            "value": "time"
          },
          "title": {
            "source": "field",
            "value": "title"
          },
          "text": {
            "source": "field",
            "value": "text"
          }
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "apardev-flare-datasource",
          "uid": "${DS_FLARE}"
        },
        "query": {
          "kind": "sessionServices",
          "refId": "service"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "options": [],
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Crash-free sessions",
      "type": "timeseries",
      "description": "Share of sessions per app version that did not crash. A drop right after a marked release points at it.",
      "datasource": {
        "type": "apardev-flare-datasource",
        "uid": "${DS_FLARE}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "apardev-flare-datasource",
            "uid": "${DS_FLARE}"
          },
          "kind": "releaseHealthTrend",
          "service": "$service",
          "trendMetric": "crashFreeSessions"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "min"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Sessions",
      "type": "timeseries",
      "description": "Sessions per app version over time: how fast a release is rolling out.",
      "datasource": {
        "type": "apardev-flare-datasource",
        "uid": "${DS_FLARE}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "apardev-flare-datasource",
            "uid": "${DS_FLARE}"
          },
          "kind": "releaseHealthTrend",
          "service": "$service",
          "trendMetric": "sessions"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Release health",
      "type": "table",
      "description": "Sessions, crashes and users per app version in the time range (at most the last 7 days).",
      "datasource": {
        "type": "apardev-flare-datasource",
        "uid": "${DS_FLARE}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "apardev-flare-datasource",
            "uid": "${DS_FLARE}"
          },
          "kind": "releaseHealth",
          "service": "$service"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Sessions",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "App starts",
      "type": "table",
      "description": "Cold and warm start duration (app.start spans) per version.",
      "datasource": {
        "type": "apardev-flare-datasource",
        "uid": "${DS_FLARE}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "apardev-flare-datasource",
            "uid": "${DS_FLARE}"
          },
          "kind": "appStarts",
          "service": "$service"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "p95",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Screen performance",
      "type": "table",
      "description": "Screen load time (screen.load) and share of slow and frozen frames (screen.frames) per screen.",
      "datasource": {
        "type": "apardev-flare-datasource",
        "uid": "${DS_FLARE}"
      },
      "gridPos": {
        "x": 10,
        "y": 17,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "apardev-flare-datasource",
            "uid": "${DS_FLARE}"
          },
          "kind": "screenPerformance",
          "service": "$service"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Load p95",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Top errors",
      "type": "table",
      "description": "Exception groups ranked by occurrences.",
      "datasource": {
        "type": "apardev-flare-datasource",
        "uid": "${DS_FLARE}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "apardev-flare-datasource",
            "uid": "${DS_FLARE}"
          },
          "kind": "errors",
          "service": "$service",
          "topN": 20
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Occurrences",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Sessions with errors",
      "type": "table",
      "description": "Most recent sessions that hit at least one error. A session ID opens it in Flare when the data source has a dashboard URL.",
      "datasource": {
        "type": "apardev-flare-datasource",
        "uid": "${DS_FLARE}"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "apardev-flare-datasource",
            "uid": "${DS_FLARE}"
          },
          "kind": "sessions",
          "service": "$service",
          "errorsOnly": true
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Last seen",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "device"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traces"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "spans"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "title": "Error triage",
      "type": "table",
      "description": "Status, assignee and regressions of the error groups people triaged.",
      "datasource": {
        "type": "apardev-flare-datasource",
        "uid": "${DS_FLARE}"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "apardev-flare-datasource",
            "uid": "${DS_FLARE}"
          },
          "kind": "issues"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Updated",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
