{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "Flare",
  "id": "apardev-flare-datasource",
  "metrics": true,
  "backend": false,
  "routes": [
    {
      "path": "flare",
      "url": "{{ .JsonData.url }}",
      "headers": [{ "name": "Authorization", "content": "Bearer {{ .SecureJsonData.token }}" }]
    }
  ],
  "info": {
    "description": "Query Flare sessions, errors, releases and release health: the data the Prometheus, Loki and Tempo compatible APIs cannot express.",
    "author": {
      "name": "Apardev"
    },
    "keywords": ["datasource", "flare", "observability", "sessions", "errors", "release health"],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [],
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=13.2.0",
    "plugins": []
  }
}
