<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NuGet package metadata. Version starts pre-1.0 - pre-alpha, no 1.0 yet, and this
         package's own version number is deliberately NOT the same number as the Docker image
         tag it defaults to - see FlareResourceBuilderExtensions.AddFlare's imageTag doc comment.
         AddFlare's imageTag default is instead pinned to a specific known-good Flare image
         version (currently "0.2.0"), bumped as part of cutting each new release of *this*
         package once tested against a newer Flare image - the two numbering schemes stay
         independent even though the pin tracks Flare's latest stable release.

         PackageId is Flare.Hosting.Aspire, NOT Aspire.Hosting.Flare - that prefix is reserved on
         nuget.org (Microsoft owns the real Aspire.Hosting.* namespace for official integrations).
         A push under it gets silently swallowed: accepted into nuget.org's storage (permanently
         burning the id+version) but never listed/indexed/visible anywhere, with no error and no
         email. Discovered 2026-08-08 checking why a "successful" CI publish never appeared on
         nuget.org - see Planning.md. Project/directory/namespace names are unaffected; only the
         published package identity changed. -->
    <PackageId>Flare.Hosting.Aspire</PackageId>
    <!-- Bumped 0.2.0 -> 0.2.1: AddFlare's imageTag default changed from the floating "edge"
         tag to a pinned stable release ("0.2.0") - a patch bump, not minor, since this only
         changes a default value (already documented as forthcoming), not new API surface.
         Bumped 0.2.1 -> 0.2.2 (2026-08-29): fixed WithFlareResourceLabels unconditionally
         calling PublishAsDockerComposeService, which registered Aspire's own
         validate-docker-compose pipeline step regardless of target and hard-failed `aspire
         publish`/`aspire deploy` for every non-Docker-Compose target (Kubernetes, Azure, AWS,
         ...) - see FlareResourceBuilderExtensions.WithFlareResourceLabels's remarks and
         docs/aspire-hosting.md's Kubernetes section. A patch bump - a behavior fix, not new API
         surface.
         Bumped 0.2.2 -> 0.2.3 (2026-08-29, same day): fixed ClickHouse's/Redis's
         WithDataVolume() calls to pass an explicit dot-free volume name
         ($"{name}-clickhouse-data"/$"{name}-redis-data"), matching the pattern the identity
         volume already used. Confirmed live against a real k3s cluster: Aspire's Kubernetes
         publisher builds the *default* WithDataVolume() name from the AppHost project's own
         name without DNS-1123 sanitization, and ".AppHost"-suffixed project names (the
         standard Aspire template convention - examples/ExampleApp.AppHost and this repo's own
         Flare.AppHost both use it) produce a volume name containing a dot, which Kubernetes
         rejects outright ("must not contain dots") - the StatefulSet can never create a pod,
         at all, for any consumer using the default AppHost naming convention. Confirmed the
         fix live too: full stack (including ClickHouse/Redis StatefulSets) reached Running
         1/1 and `flare-api`'s /health returned 200 through a real Kubernetes Service on a
         local k3s cluster. Another patch bump - a behavior fix, not new API surface. Tag on
         release: aspire-hosting-flare-v{Version} (see
         .github/workflows/nuget-publish.yml). -->
    <Version>0.2.3</Version>
    <Authors>Amin Parsa</Authors>
    <Description>.NET Aspire hosting integration for Flare, a self-hosted OpenTelemetry-native log dashboard. Adds the whole Flare stack (ClickHouse, Redis, OTLP ingest, query API, dashboard) to your AppHost with builder.AddFlare("flare"), wrapping Flare's published Docker Hub images.</Description>
    <PackageTags>aspire;aspire-hosting;flare;opentelemetry;otlp;logging;observability;clickhouse;redis</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/aminparsa18/Flare.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aminparsa18/Flare.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packed straight from their existing location - not physically copied into this project. -->
    <None Include="..\..\logo.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Aspire.Hosting directly (not Aspire.Hosting.AppHost - that meta-package + the
         Aspire.AppHost.Sdk combo is for the AppHost *executable* project itself; a hosting
         integration library depends on Aspire.Hosting directly, per Aspire's "Create custom
         hosting integrations" doc). ClickHouse/Redis give AddClickHouse/AddDatabase/AddRedis/
         WithDataVolume/WithPersistence, mirroring Flare.AppHost/Program.cs's own resource graph. -->
    <PackageReference Include="Aspire.Hosting" />
    <PackageReference Include="Aspire.Hosting.ClickHouse" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <!-- PublishAsDockerComposeService only - see Directory.Packages.props's pin comment. -->
    <PackageReference Include="Aspire.Hosting.Docker" />
  </ItemGroup>

  <ItemGroup>
    <!-- ClickHouse init scripts embedded so AddFlare() can materialize them to a temp directory
         and WithBindMount it into a consumer's ClickHouse container - a consuming repo doesn't
         have db/clickhouse/ on disk the way this repo's own Flare.AppHost does. LogicalName is
         pinned explicitly (rather than relying on MSBuild's default dot-joined logical name) so
         FlareResourceBuilderExtensions can look resources up by an exact, known prefix instead
         of parsing generated names. -->
    <EmbeddedResource Include="..\..\db\clickhouse\*.sql">
      <LogicalName>Aspire.Hosting.Flare.ClickHouseInit.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
