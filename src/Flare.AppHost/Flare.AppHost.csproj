<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>flare-apphost-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspire 17 C# AppHost shape: plain Microsoft.NET.Sdk plus these two packages, replacing
         the obsolete Aspire.AppHost.Sdk (ASPIRE012). Aspire.Hosting.Dotnet supplies
         AddDotnetProject; the dashboard and DCP come from the Aspire CLI bundle. -->
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
    <PackageReference Include="Aspire.Hosting.ClickHouse" />
    <PackageReference Include="Aspire.Hosting.Redis" />
  </ItemGroup>

  <!-- No ProjectReferences to Flare.Ingest/Api/AlertWorker: AppHost.cs registers them by path
       with AddDotnetProject, which builds them itself, so no Projects.* metadata is needed. -->

</Project>
