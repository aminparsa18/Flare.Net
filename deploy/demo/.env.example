# Copy to .env (same folder) and fill in. Keep .env out of git - it holds the demo's secrets.
# Generate passwords with: openssl rand -hex 24  (hex keeps them shell- and URL-safe)

# Public hostname. Its DNS A record must point at this server before the first start,
# so Caddy can get a certificate.
DEMO_DOMAIN=demo.flarenet.live

# The one Admin account. Created on the first start; the demo refuses to start without it.
# Pick a non-obvious username - the login form is public.
FLARE_ADMIN_USERNAME=
FLARE_ADMIN_PASSWORD=

CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
POSTGRES_PASSWORD=

# Image tags. edge = latest main build on Docker Hub (demo mode needs a build that has ADR-0278).
FLARE_IMAGE_TAG=edge
SHOP_IMAGE_TAG=latest
