        },
        "password": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            }
          }
        },
        "password": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "Sqlite",
            "Postgres"
          ]
        },
        "sqlite": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accessMode": {
              "type": "string",
