              }
            },
            "password": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "external": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "connectionString": {
                  "type": "string"
                },
                "existingSecret": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
