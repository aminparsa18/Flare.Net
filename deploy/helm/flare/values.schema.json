          "type": "boolean"
        },
        "password": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "clickhouse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "external": {
          "type": "object",
