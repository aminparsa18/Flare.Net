# Copy to .env (docker compose reads it automatically) to override any of these.
# Every value below has a working default baked into docker-compose.yml already, so
# `docker compose up` works with zero setup - per Planning.md's "least overhead to try"
# principle. Overriding matters once you're running this somewhere the defaults aren't
# good enough (a shared box, anything reachable beyond localhost).

# --- Credentials -------------------------------------------------------------
# Both default to "flare" in docker-compose.yml if unset. Flare has no v1 auth story
# yet (Planning.md's roadmap), so these only gate ClickHouse/Redis themselves, not
# Flare's own HTTP surfaces - still worth changing before exposing this stack beyond
# localhost.
CLICKHOUSE_PASSWORD=flare
REDIS_PASSWORD=flare

# --- Host ports ----------------------------------------------------------------
# Change these if something on your machine already owns one of the defaults.
FLARE_INGEST_GRPC_PORT=4317
FLARE_INGEST_HTTP_PORT=4318
FLARE_API_PORT=8080
FLARE_DASHBOARD_PORT=3000
# ClickHouse's HTTP interface, exposed for the ad hoc verification queries in
# db/clickhouse/README.md - not needed for the stack to function.
CLICKHOUSE_HTTP_PORT=8123

# --- Dashboard --------------------------------------------------------------
# Must be reachable from *your browser*, not from inside the compose network - the
# dashboard is a client-rendered SPA (src/dashboard/src/lib/api.ts calls this directly
# from JS running on your machine), so "http://api:8080" (the in-network service name)
# would not resolve. Defaults to http://localhost:$FLARE_API_PORT, which matches
# opening the dashboard at http://localhost:$FLARE_DASHBOARD_PORT on the same machine.
# Override if you're opening the dashboard from a different host than the one running
# `docker compose up`.
PUBLIC_API_URL=http://localhost:8080
