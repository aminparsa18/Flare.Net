# Copy to .env (docker compose reads it automatically) to override any of these.
# Every value below has a working default baked into docker-compose.yml already, so
# `docker compose up` works with zero setup - per Planning.md's "least overhead to try"
# principle. Overriding matters once you're running this somewhere the defaults aren't
# good enough (a shared box, anything reachable beyond localhost).

# --- Credentials -------------------------------------------------------------
# Both default to "flare" in docker-compose.yml if unset. These gate ClickHouse/Redis
# themselves, not Flare's own HTTP surfaces (see docs/auth.md for that - a per-instance
# admin account you create on first run, not an env var) - still worth changing before
# exposing this stack beyond localhost.
CLICKHOUSE_PASSWORD=flare
REDIS_PASSWORD=flare

# --- Host ports ----------------------------------------------------------------
# Change these if something on your machine already owns one of the defaults.
FLARE_INGEST_GRPC_PORT=4317
FLARE_INGEST_HTTP_PORT=4318
FLARE_API_PORT=8080
FLARE_DASHBOARD_PORT=3000
# ClickHouse's HTTP interface, exposed for the ad hoc verification queries in
# db/clickhouse/README.md - not needed for the stack to function.
CLICKHOUSE_HTTP_PORT=8123

# --- Alerting: Email channel --------------------------------------------------
# App-wide SMTP server the alerting Email channel sends through (see
# src/Flare.Api/README.md's "Alerting" section). No working default - there's no
# sensible default mail server - so a rule whose channel is Email just fails per-send
# with a clear error until these are set. Leave unset if you don't plan to use the
# Email channel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# STARTTLS is the common case (e.g. port 587) - set to false for a server that doesn't
# advertise it (some local/self-hosted relays), otherwise the connect fails outright.
SMTP_USE_STARTTLS=true

# --- Ingestion pipeline stream/consumer-group overrides -----------------------
# Advanced / rarely needed. Flare.Ingest's Redis Streams buffering layer is
# independently configurable via the standard ASP.NET Core "Section__Property" env var
# convention: LogEventPipeline__StreamKey / LogEventPipeline__ConsumerGroup (and the
# SpanEventPipeline__.../MetricEventPipeline__... equivalents for traces/metrics). If you
# ever override one of these on the `ingest` service, you must apply the SAME override to
# the `api` service too - Flare.Api binds its own local, read-only copy of the same config
# section to power the Ingestion page's pipeline-health panel and live tail (see
# src/Flare.Api/Pipeline/LogEventPipelineOptions.cs's remarks); the two processes don't
# share a config source, so setting it on only one side leaves the other still pointed at
# the default. Nobody overrides these today, and docker-compose.yml doesn't expose them as
# top-level knobs above - add them directly as `environment:` entries on both the `ingest`
# and `api` services in docker-compose.yml (or your own orchestration) if you ever need to,
# e.g.:
#   LogEventPipeline__StreamKey: "flare:logs"
#   LogEventPipeline__ConsumerGroup: "flare-ingest"

# --- Auth --------------------------------------------------------------------
# The identity store's location (Identity__DbPath) and the CORS allowed-origin
# (Cors__AllowedOrigins__0) are both already wired in docker-compose.yml from
# FLARE_DASHBOARD_PORT above, so they stay in sync automatically. See docs/auth.md: the
# actual admin account is created via the dashboard's first-run /setup flow, not an env
# var. Microsoft Entra ID (SSO) is configured the same way - no env vars here at all -
# via the Admin-only Security screen in the dashboard (/security) once you've signed in,
# not docker-compose/.env. See docs/auth.md's "Microsoft Entra ID (SSO)" section.

# --- Dashboard --------------------------------------------------------------
# Must be reachable from *your browser*, not from inside the compose network - the
# dashboard is a client-rendered SPA (src/dashboard/src/lib/api.ts calls this directly
# from JS running on your machine), so "http://api:8080" (the in-network service name)
# would not resolve. Defaults to http://localhost:$FLARE_API_PORT, which matches
# opening the dashboard at http://localhost:$FLARE_DASHBOARD_PORT on the same machine.
# Override if you're opening the dashboard from a different host than the one running
# `docker compose up`.
PUBLIC_API_URL=http://localhost:8080
