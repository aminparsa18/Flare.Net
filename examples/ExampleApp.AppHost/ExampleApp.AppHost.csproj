<Project Sdk="Aspire.AppHost.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>exampleapp-apphost-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <!-- AddDockerComposeEnvironment - proves out docs/aspire-hosting.md's "Publishing /
         deploying via aspire publish" section end-to-end (`aspire publish`/`aspire deploy`
         against this AppHost). Purely a deployment target: registering it has no effect on
         the default `aspire run`/`dotnet run` inner loop. -->
    <PackageReference Include="Aspire.Hosting.Docker" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not yet published to nuget.org - referenced directly so this example proves the
         package works before packing/pushing it (see docs/aspire-hosting.md). Once
         published, a real consumer would use:
           <PackageReference Include="Flare.Hosting.Aspire" Version="x.y.z" />
         instead - PackageId Flare.Hosting.Aspire, NOT Aspire.Hosting.Flare (that prefix is
         reserved on nuget.org for Microsoft's own official integrations; see this project's
         .csproj). IsAspireProjectResource=false tells Aspire's tooling this is a plain
         class-library reference, not a project resource to orchestrate - same pattern
         Aspire's own "Create custom hosting integrations" doc uses for a hosting-library
         reference from an AppHost. -->
    <ProjectReference Include="..\..\src\Aspire.Hosting.Flare\Aspire.Hosting.Flare.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\ExampleApp.LogGenerator\ExampleApp.LogGenerator.csproj" />
  </ItemGroup>

</Project>
