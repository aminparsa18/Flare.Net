<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>exampleapp-apphost-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspire 17 C# AppHost shape (replaces the obsolete Aspire.AppHost.Sdk, ASPIRE012);
         Aspire.Hosting.Dotnet supplies AddDotnetProject. Same as src/Flare.AppHost. -->
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
    <!-- AddKubernetesEnvironment - the optional k3s publish target (see examples/README.md).
         Registering it has no effect on the default `aspire run`/`dotnet run` inner loop. -->
    <PackageReference Include="Aspire.Hosting.Kubernetes" />
    <!-- The shop demo's backing services (see Program.cs): Kafka for the Message queues
         page, Postgres for the Services breakdown's Database tab. -->
    <PackageReference Include="Aspire.Hosting.Kafka" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not yet published to nuget.org - referenced directly so this example proves the
         package works before packing/pushing it (see docs/aspire-hosting.md). Once
         published, a real consumer would use:
           <PackageReference Include="Flare.Hosting.Aspire" Version="x.y.z" />
         instead - PackageId Flare.Hosting.Aspire, NOT Aspire.Hosting.Flare (that prefix is
         reserved on nuget.org for Microsoft's own official integrations; see this project's
         .csproj). An ordinary library reference under Microsoft.NET.Sdk. -->
    <ProjectReference Include="..\..\src\Aspire.Hosting.Flare\Aspire.Hosting.Flare.csproj" />
  </ItemGroup>

  <!-- No ProjectReference to ExampleApp.Shop: Program.cs registers it by path with
       AddDotnetProject, which builds it itself. -->

</Project>
